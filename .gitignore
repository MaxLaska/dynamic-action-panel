# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Build output directory
# Contains exactly the compiled plugin files (main.js, styles.css, manifest.json),
# and nothing else: the build writes only those three and deployment no longer
# stages anything here. These files are uploaded to GitHub releases rather than
# committed. If a data.json ever reappears in dist, something has regressed.
dist

# Exclude sourcemaps
*.map

# obsidian
data.json

# Deployment backups. They live outside the repository (see BACKUP_ROOT in
# scripts/deployCore.mjs) precisely because they contain a vault's data.json;
# this entry is here so that pointing them back inside cannot publish it.
ocap-backups

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# other
*.zip
.env

# references
references

# CodeBuddy AI tooling config (skills, memory, automations)
.codebuddy