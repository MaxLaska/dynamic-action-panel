# ============================================
# Obsidian plugin development configuration
# ============================================
# 
# How to use:
# 1. Copy this file to .env
# 2. Fill in the path to your Obsidian vault
# 3. .env is listed in .gitignore and is never committed

# Path to the Obsidian vault
# 
# Windows example (forward slashes recommended):
# VAULT_PATH=C:/Users/YourName/Documents/MyVault
# VAULT_PATH=C:/Users/YourName/Documents/My Vault
# 
# Windows example (backslashes must be escaped):
# VAULT_PATH=C:\\Users\\YourName\\Documents\\MyVault
# 
# macOS/Linux example:
# VAULT_PATH=/Users/YourName/Documents/MyVault
# VAULT_PATH=/home/username/Documents/MyVault
# 
# Notes:
# - On Windows prefer forward slashes `/`; Node.js handles them fine
# - A backslash `\` must be escaped as `\\`
# - Paths containing spaces do not need quotes
# - Lines starting with `#` are comments

VAULT_PATH=